          "name": "Staff: +1",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/queue/{{stallId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "queue",
                "{{stallId}}"
